# docker-compose (postgres, redis) — читается docker compose из .env в корне
POSTGRES_USER=convert_hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=convert_hub
POSTGRES_PORT=5432
REDIS_PORT=6379

# производные строки подключения — понадобятся приложению, когда появятся
# ORM (спека 003) и rate limit/idempotency (спека 012)
DATABASE_URL=postgresql://convert_hub:change-me@localhost:5432/convert_hub
REDIS_URL=redis://localhost:6379
