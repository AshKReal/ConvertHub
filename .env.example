# docker-compose (postgres, redis, mailhog) — читается docker compose из .env в корне
POSTGRES_USER=convert_hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=convert_hub
POSTGRES_PORT=5432
REDIS_PORT=6379
# спека 009 — SMTP-порт MailHog (принимает apps/api) и порт веб-интерфейса (посмотреть письма)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# производные строки подключения — читает docker compose и Prisma CLI при
# прямом вызове из корня; сам apps/api и `pnpm --filter api exec prisma ...`
# читают одноимённую переменную из apps/api/.env, не эту (docs/SETUP.md)
DATABASE_URL=postgresql://convert_hub:change-me@localhost:5432/convert_hub
# понадобится rate limit/idempotency (спека 012), кодом пока не читается
REDIS_URL=redis://localhost:6379
