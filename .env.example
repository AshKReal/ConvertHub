# docker-compose (postgres, redis, mailhog) — читается docker compose из .env в корне
POSTGRES_USER=convert_hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=convert_hub
POSTGRES_PORT=5432
REDIS_PORT=6379
# спека 009 — SMTP-порт MailHog (принимает apps/api) и порт веб-интерфейса (посмотреть письма)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# производные строки подключения — читает docker compose и Prisma CLI при
# прямом вызове из корня; сам apps/api и `pnpm --filter api exec prisma ...`
# читают одноимённую переменную из apps/api/.env, не эту (docs/SETUP.md)
DATABASE_URL=postgresql://convert_hub:change-me@localhost:5432/convert_hub
# понадобится rate limit/idempotency (спека 012), кодом пока не читается
REDIS_URL=redis://localhost:6379

# спека 016 — MinIO (STORAGE_DRIVER=s3). Локальное объектное хранилище на сети
# compose; в проде вместо него Cloudflare R2 (docs/DEPLOYMENT.md). Значения по
# умолчанию есть в docker-compose.yml — переопределять не обязательно.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=convert-hub

# Секреты контейнера `api` (профиль `full`: docker compose --profile full up).
# Рабочих дефолтов в docker-compose.yml НЕТ намеренно — без этих переменных
# compose откажется стартовать, а не поднимет стенд с ключом подписи из
# публичного репозитория (REVIEW-FINDINGS.md, INFRA-01).
# Сгенерировать каждый: openssl rand -base64 32
# `pnpm dev:api` снаружи их не читает — у него свой apps/api/.env.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
SIGNED_URL_SECRET=change-me-generate-with-openssl-rand-base64-32
METRICS_TOKEN=change-me-generate-16-plus
