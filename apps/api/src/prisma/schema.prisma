generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Минимальная таблица (спека 003) расширена спекой 007: email/passwordHash,
/// спекой 008: nullable passwordHash + identities (чисто-OAuth пользователь).
model User {
  id           String @id @db.VarChar(26)
  /// Спека 007. Хранится и сравнивается в нижнем регистре — нормализация
  /// на входе (`auth.service.ts`), не в БД.
  email        String @unique
  /// argon2id (`AUTH-RULES.md` §2). Nullable с 008 — пользователь, созданный
  /// через Google, пароля не имеет; `login()` (007) уже безопасен на этот
  /// случай (`user?.passwordHash ?? DUMMY_PASSWORD_HASH`).
  passwordHash String? @map("password_hash")

  storageUsedBytes Int      @default(0) @map("storage_used_bytes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  files               File[]
  conversions         Conversion[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  identities          Identity[]
  apiKeys             ApiKey[]

  @@map("users")
}

/// Спека 011. `TECH-SPEC.md` §8.4: в БД — только SHA-256 хеш ключа и префикс
/// для показа; полное значение отдаётся клиенту один раз, при выпуске и
/// перевыпуске. Ключ — неизменяемая строка (та же модель, что `RefreshToken`
/// 007, не UPDATE на месте): перевыпуск = `revokedAt` старой строке + INSERT
/// новой в одной транзакции, отзыв = `revokedAt`. `revokedAt IS NULL` —
/// единственный предикат «ключ действует».
model ApiKey {
  id String @id @db.VarChar(26)

  userId String @map("user_id") @db.VarChar(26)

  /// SHA-256 hex полного значения (`AUTH-RULES.md` §2: SHA-256 предписан для
  /// высокоэнтропийных ключей, не argon2). Поиск — точный матч по `@unique`
  /// индексу, тайминг не несёт информации о содержимом (довод `RefreshToken`).
  keyHash String @unique @map("key_hash")

  /// Первые 12 символов значения (`ch_live_a1b2`) — для показа в списке, не секрет.
  prefix String

  environment ApiKeyEnvironment @default(LIVE)

  createdAt DateTime @default(now()) @map("created_at")

  /// Пишет только 012 при аутентификации запроса ключом. NULL — ещё не использован.
  lastUsedAt DateTime? @map("last_used_at")

  /// NULL — ключ действует. Проставляется при отзыве и перевыпуске (старой строке).
  revokedAt DateTime? @map("revoked_at")

  /// Cascade — то же решение владельца, что 008/009: удаление аккаунта убирает
  /// ключи одним вызовом `prisma.user.delete()`.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

/// Спека 011. Формат ключа несёт признак окружения (`ch_live_`/`ch_test_`,
/// `TECH-SPEC.md` §7.1). Сейчас выпускается только `LIVE`; `TEST` активируется,
/// если появится песочница с иными лимитами.
enum ApiKeyEnvironment {
  LIVE
  TEST
}

/// Спека 008. Идентификация по `sub` провайдера (`AUTH-RULES.md`), не по
/// email — email на стороне провайдера может смениться. Составной уникальный
/// индекс: один provider_uid не может быть привязан дважды ни к какому
/// аккаунту.
model Identity {
  id          String           @id @db.VarChar(26)
  userId      String           @map("user_id") @db.VarChar(26)
  provider    IdentityProvider
  providerUid String           @map("provider_uid")
  createdAt   DateTime         @default(now()) @map("created_at")

  /// Cascade — то же решение владельца, что 009: удаление аккаунта стирает
  /// все его идентичности одним вызовом `prisma.user.delete()`.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("identities")
}

/// Спека 008. Пока один провайдер (`AUTH-RULES.md` §5) — Telegram добавится
/// сюда же новым значением, когда/если вернётся в план.
enum IdentityProvider {
  GOOGLE
}

/// Спека 009. Тот же приём, что `RefreshToken` (007): опаковый токен, в БД
/// только SHA-256 хеш. Без `replacedById`/окна терпимости — это одноразовое
/// действие (ссылка на сброс пароля), не сессия, гонку ротации между
/// вкладками моделировать незачем.
model PasswordResetToken {
  id        String    @id @db.VarChar(26)
  userId    String    @map("user_id") @db.VarChar(26)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  /// NULL — ещё активен. Запрос нового токена помечает использованными
  /// все предыдущие активные — не больше одной живой ссылки одновременно.
  usedAt DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Спека 007. Опаковый токен, не JWT: нужна возможность мгновенно отозвать
/// всю цепочку при обнаруженной краже (`AUTH-RULES.md` §2) — у
/// самоподписанного JWT такой возможности нет без отдельного blocklist, а
/// раз БД всё равно нужна, опаковый токен + хеш проще.
model RefreshToken {
  id     String @id @db.VarChar(26)
  userId String @map("user_id") @db.VarChar(26)
  /// SHA-256 (не argon2) — токен генерируется системой, 256 бит энтропии,
  /// не пароль; тот же довод, что для API-ключей (`AUTH-RULES.md` §2).
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  /// Момент ротации (эта запись обменяна на новую). NULL — ещё активна.
  usedAt DateTime? @map("used_at")
  /// Куда указывает цепочка после ротации — звено, по которому окно
  /// терпимости (`auth.service.ts#refresh`) находит актуальный токен.
  replacedById String? @map("replaced_by_id") @db.VarChar(26)
  /// Логаут или обнаруженная кража — обе причины схлопываются в одно
  /// поле, различать их дальше незачем: и то и то "эта запись мертва".
  revokedAt DateTime? @map("revoked_at")

  /// Cascade (спека 009, решение владельца — было Restrict, 003 сознательно
  /// откладывала это решение): удаление аккаунта убивает все его сессии
  /// одним вызовом `prisma.user.delete()`, без отдельного шага.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// TECH-SPEC.md §4: в истории конвертаций нет состояния "в процессе",
/// только Completed и Failed — API синхронный.
enum ConversionStatus {
  COMPLETED
  FAILED
}

model File {
  id               String    @id @db.VarChar(26)
  /// null — гость; спека 003 никогда не создаёт синтетическую строку в
  /// users для гостя, лимиты гостя считаются по IP (TECH-SPEC.md §6), не
  /// по учётной записи.
  userId           String?   @map("user_id") @db.VarChar(26)
  storageKey       String    @unique @map("storage_key")
  sizeBytes        Int       @map("size_bytes")
  mime             String
  extension        String    @db.VarChar(8)
  originalFilename String?   @map("original_filename")
  /// null = бессрочно (save=true); иначе TTL из ARCHITECTURE.md §11.
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  /// Cascade (спека 009, было Restrict) — удаление аккаунта стирает и его
  /// сохранённые файлы; реальные байты в `Storage` чистит `AccountService`
  /// ДО этого вызова (иначе `storageKey` потеряется вместе со строкой).
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversions Conversion[]

  // idx_files_expiring (WHERE expires_at IS NOT NULL, ARCHITECTURE.md §10)
  // добавлен ВРУЧНУЮ в migrations/<ts>_init/migration.sql — частичные
  // индексы недоступны в Prisma 6 schema DSL (preview partialIndexes
  // только с v7.4). Здесь намеренно нет @@index([expiresAt]), чтобы Prisma
  // не продублировала его обычным полным индексом при следующем migrate dev.
  @@index([userId, id], map: "idx_files_user_cursor")
  @@map("files")
}

model Conversion {
  id          String           @id @db.VarChar(26)
  userId      String?          @map("user_id") @db.VarChar(26)
  target      String           @db.VarChar(8)
  /// null, если конвертация упала до определения направления.
  directionId String?          @map("direction_id") @db.VarChar(32)
  status      ConversionStatus
  errorCode   String?          @map("error_code") @db.VarChar(64)
  durationMs  Int              @map("duration_ms")
  /// Заполнен только при COMPLETED && save=true && персист удался.
  fileId      String?          @map("file_id") @db.VarChar(26)
  createdAt   DateTime         @default(now()) @map("created_at")

  /// Cascade (спека 009, было Restrict) — история конвертаций уходит вместе с аккаунтом.
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId, id], map: "idx_conversions_user_cursor")
  @@map("conversions")
}
