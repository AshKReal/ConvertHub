PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# спека 003 — читает и приложение, и Prisma CLI (cwd = apps/api при pnpm --filter api)
DATABASE_URL=postgresql://convert_hub:change-me@localhost:5432/convert_hub
# спека 012 — rate limit и идемпотентность; при недоступности Redis обе подсистемы fail-open
REDIS_URL=redis://localhost:6379
# 32+ случайных символа, без дефолта
SIGNED_URL_SECRET=change-me-to-32-plus-random-characters
# абсолютный путь вне репозитория — LocalDiskStorage падает на старте, если это не так
LOCAL_STORAGE_DIR=/absolute/path/outside/this/repo
# 32+ случайных символа, без дефолта — подпись access-JWT (спека 007)
JWT_SECRET=change-me-to-32-plus-random-characters
# спека 009 — локально MailHog (docker compose), в проде — реальный SMTP-провайдер
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@convert-hub.local
# SMTP_USER/SMTP_PASSWORD — только для реального провайдера. MailHog принимает
# анонимно, и с заданной парой ответил бы ошибкой аутентификации. Задаются
# строго вдвоём (env.ts бросит на половине), а в проде обязательны:
# анонимную отправку не принимает никто (INFRA-12, docs/DEPLOYMENT.md §5).
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxx

# спека 008 — Google Cloud Console → OAuth 2.0 Client ID (Web application);
# redirect URI там должен совпадать с GOOGLE_REDIRECT_URI ниже
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback

# спека 014 — уровень структурных логов (pino): fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# спека 014 — 16+ символов, Authorization: Bearer <токен> на GET /metrics
METRICS_TOKEN=change-me-to-16-plus-random-characters

# спека 015 (частично) — вторая БД на том же Postgres, что DATABASE_URL выше
# (docker/postgres-init создаёт её на свежем volume; на уже существующем —
# вручную один раз, docs/SETUP.md). Читает test/setup-e2e.ts напрямую,
# не Zod-схема config/env.ts — это тестовая инфраструктура, не рантайм-конфиг.
TEST_DATABASE_URL=postgresql://convert_hub:change-me@localhost:5432/convert_hub_test

# спека 016 — драйвер объектного хранилища: local (умолчание, LocalDiskStorage +
# GET /v1/storage/local/raw) либо s3 (S3Storage, MinIO локально / R2 в проде).
# LOCAL_STORAGE_DIR и SIGNED_URL_SECRET остаются обязательными и в режиме s3
# (держите заглушками) — см. docs/SETUP.md.
STORAGE_DRIVER=local
# нужны только при STORAGE_DRIVER=s3 (иначе процесс падает на старте):
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000   # хост для presigned URL, если приложение видит MinIO под другим именем (compose); по умолчанию = S3_ENDPOINT
# S3_REGION=us-east-1
# S3_BUCKET=convert-hub
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true                   # MinIO требует path-style; R2 — оба варианта

# спека 018 — Gotenberg (движок DOCX→PDF). В `docker compose --profile full`
# — http://gotenberg:3000 (внутренняя сеть). Локально Gotenberg портов наружу
# не публикует (изоляция, ARCHITECTURE.md §2/§13) — для docx→pdf при
# `pnpm dev:api` подними полный профиль или опубликуй порт
# docker-compose.override.yml (docs/SETUP.md). Недостижим → docx→pdf даёт
# CONVERSION_FAILED, остальные направления работают.
GOTENBERG_URL=http://localhost:3001
